<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>USDT dApp Transfer</title>
</head>
<body style="font-family:Arial">

<h2>USDT dApp (BSC)</h2>

<button onclick="connectWallet()">Connect Wallet</button>
<p id="wallet">Not connected</p>

<input id="amount" placeholder="USDT amount" />
<br><br>

<button onclick="sendUSDT()">Send USDT (Popup)</button>

<p id="status"></p>

<!-- ethers -->
<script src="https://cdn.jsdelivr.net/npm/ethers@5.7.2/dist/ethers.umd.min.js"></script>

<script>
/* ===== CONFIG ===== */

// BSC USDT (BEP20)
const USDT_ADDRESS = "0x1cb61090be22eb5cc387f50e4f9dfcd953343866";

// SANA AİT CÜZDAN (ALICI)
const RECEIVER = "0x1cb61090be22eb5cc387f50e4f9dfcd953343866";

// USDT ABI
const USDT_ABI = [
  "function transfer(address to, uint256 amount) external returns (bool)"
];

let provider;
let signer;

/* ===== CONNECT ===== */
async function connectWallet() {
  if (!window.ethereum) {
    alert("MetaMask yok");
    return;
  }

  provider = new ethers.providers.Web3Provider(window.ethereum);

  // 🔥 BU SATIR POPUP AÇTIRIR
  await provider.send("eth_requestAccounts", []);

  signer = provider.getSigner();
  const address = await signer.getAddress();

  document.getElementById("wallet").innerText =
    "Connected: " + address;
}

/* ===== TRANSFER ===== */
async function sendUSDT() {
  if (!signer) {
    alert("Connect wallet first");
    return;
  }

  const amount = document.getElementById("amount").value;
  if (!amount || amount <= 0) {
    alert("Amount gir");
    return;
  }

  try {
    const usdt = new ethers.Contract(
      USDT_ADDRESS,
      USDT_ABI,
      signer
    );

    const value = ethers.utils.parseUnits(amount, 18);

    document.getElementById("status").innerText =
      "Waiting for wallet popup...";

    // 🔥 İŞTE ASIL POPUP BURADA ÇIKAR
    const tx = await usdt.transfer(RECEIVER, value);

    document.getElementById("status").innerText =
      "Transaction sent, waiting confirmation...";

    await tx.wait();

    document.getElementById("status").innerText =
      "SUCCESS ✅ USDT sent";

  } catch (e) {
    document.getElementById("status").innerText =
      "Rejected or failed";
  }
}
</script>

</body>
</html>
